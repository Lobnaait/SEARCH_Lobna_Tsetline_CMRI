        "# =====================================================================\n",
        "# ACDC - classificazione con Tsetlin Machine usando all_features_merged.csv\n",
        "# Incolla ogni blocco \"# %%\" in una cella di Colab, oppure esegui tutto.\n",
        "# =====================================================================\n",
        "\n",
        "# %% 0. Installazione (solo se manca)\n",
        "import subprocess\n",
        "import sys\n",
        "\n",
        "try:\n",
        "    import pyTsetlinMachine  # noqa: F401\n",
        "except ImportError:\n",
        "    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n",
        "                    \"pyTsetlinMachine\", \"scikit-learn\", \"matplotlib\", \"pandas\"],\n",
        "                   check=True)\n",
        "\n",
        "# %% 1. Import e parametri\n",
        "from pathlib import Path\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import accuracy_score, confusion_matrix, classification_report\n",
        "from pyTsetlinMachine.tm import MultiClassTsetlinMachine\n",
        "\n",
        "# CSV prodotto da merge_features.py (in Colab: caricalo in /content)\n",
        "CSV_PATH = \"/content/all_features_merged.csv\"\n",
        "\n",
        "CLASSES = [\"NOR\", \"DCM\", \"HCM\", \"MINF\", \"RV\"]\n",
        "CLASS_TO_IDX = {c: i for i, c in enumerate(CLASSES)}\n",
        "\n",
        "TRAIN_IDS = list(range(1, 101))\n",
        "TEST_IDS = list(range(101, 151))\n",
        "\n",
        "# Se non None, tiene solo le K feature piu' informative (ANOVA F-test, calcolato\n",
        "# SOLO sul train) prima della binarizzazione. Con ~600 feature e 80 pazienti di\n",
        "# train puo' aiutare contro l'overfitting. None = usa tutte le feature.\n",
        "SELECT_K = None\n",
        "\n",
        "OUTPUT_DIR = Path.cwd() / \"tm_outputs\"\n",
        "OUTPUT_DIR.mkdir(exist_ok=True)\n",
        "\n",
        "\n",
        "# %% 2. Caricamento del CSV e split train/test per paziente\n",
        "def load_features(csv_path):\n",
        "    df = pd.read_csv(csv_path)\n",
        "    df = df.set_index(\"pid\").sort_index()\n",
        "\n",
        "    unknown = set(df[\"group\"].unique()) - set(CLASSES)\n",
        "    if unknown:\n",
        "        raise ValueError(f\"Etichette non riconosciute nel CSV: {unknown}\")\n",
        "\n",
        "    train_df = df.loc[df.index.isin(TRAIN_IDS)]\n",
        "    test_df = df.loc[df.index.isin(TEST_IDS)]\n",
        "\n",
        "    y_all = train_df[\"group\"].map(CLASS_TO_IDX).to_numpy()\n",
        "    y_test = test_df[\"group\"].map(CLASS_TO_IDX).to_numpy()\n",
        "    X_all = train_df.drop(columns=\"group\")\n",
        "    X_test = test_df.drop(columns=\"group\")\n",
        "\n",
        "    # 1) colonne con NaN nel train o nel test (es. le *_MWT_* di Khened, presenti\n",
        "    #    solo per i pazienti 1-100): una soglia calcolata sul train non avrebbe\n",
        "    #    senso sul test, quindi si scartano.\n",
        "    has_nan = X_all.isna().any() | X_test.isna().any()\n",
        "    if has_nan.any():\n",
        "        print(f\"Scartate {int(has_nan.sum())} colonne con valori mancanti: \"\n",
        "              f\"{has_nan[has_nan].index.tolist()}\")\n",
        "    keep = ~has_nan\n",
        "\n",
        "    # 2) colonne costanti nel train (nessuna soglia utile)\n",
        "    const = X_all.nunique() <= 1\n",
        "    if (const & keep).any():\n",
        "        print(f\"Scartate {int((const & keep).sum())} colonne costanti nel train\")\n",
        "    keep &= ~const\n",
        "\n",
        "    X_all, X_test = X_all.loc[:, keep], X_test.loc[:, keep]\n",
        "    print(f\"Train: {X_all.shape[0]} pazienti | Test: {X_test.shape[0]} pazienti | \"\n",
        "          f\"Feature: {X_all.shape[1]}\")\n",
        "    return (X_all.to_numpy(dtype=np.float64), y_all,\n",
        "            X_test.to_numpy(dtype=np.float64), y_test, list(X_all.columns))\n",
        "\n",
        "\n",
        "# %% 3. Binarizzazione (thermometer encoding)\n",
        "def compute_bin_edges(X, n_bins):\n",
        "    \"\"\"Per ogni feature, fino a n_bins soglie ai quantili (solo dal train).\n",
        "    Le soglie duplicate (feature discrete o con molti valori uguali) vengono\n",
        "    eliminate, cosi' non si creano letterali identici.\"\"\"\n",
        "    qs = np.linspace(0, 1, n_bins + 2)[1:-1]\n",
        "    return [np.unique(np.quantile(X[:, j], qs)) for j in range(X.shape[1])]\n",
        "\n",
        "\n",
        "def binarize_thermometer(X, edges):\n",
        "    \"\"\"x_ij > soglia_jk -> 1. Output uint32 di shape (n, somma soglie).\"\"\"\n",
        "    cols = []\n",
        "    for j, e in enumerate(edges):\n",
        "        for thr in e:\n",
        "            cols.append((X[:, j] > thr).astype(np.uint32))\n",
        "    return np.stack(cols, axis=1)\n",
        "\n",
        "\n",
        "# %% 4. Training con selezione dell'epoca migliore\n",
        "def train_tm_with_best_epoch(\n",
        "    X_train, y_train, X_val, y_val, X_trval, y_trval,\n",
        "    n_clauses, T, s, max_epochs, seed,\n",
        "):\n",
        "    np.random.seed(seed)\n",
        "    tm = MultiClassTsetlinMachine(n_clauses, T, s, weighted_clauses=True)\n",
        "\n",
        "    train_accs, val_accs = [], []\n",
        "    best_val_acc, best_epoch = -1.0, 0\n",
        "\n",
        "    for epoch in range(max_epochs):\n",
        "        tm.fit(X_train, y_train, epochs=1, incremental=True)\n",
        "        tr_acc = accuracy_score(y_train, tm.predict(X_train))\n",
        "        va_acc = accuracy_score(y_val, tm.predict(X_val))\n",
        "        train_accs.append(tr_acc)\n",
        "        val_accs.append(va_acc)\n",
        "        print(f\"  epoca {epoch + 1:3d}/{max_epochs}  train={tr_acc:.3f}  val={va_acc:.3f}\")\n",
        "        if va_acc > best_val_acc:\n",
        "            best_val_acc, best_epoch = va_acc, epoch\n",
        "\n",
        "    print(f\"\\n>> Epoca migliore: {best_epoch + 1} (val_acc={best_val_acc:.3f})\")\n",
        "    print(f\">> Ri-alleno da zero su train+val per {best_epoch + 1} epoche...\")\n",
        "\n",
        "    np.random.seed(seed)\n",
        "    tm_final = MultiClassTsetlinMachine(n_clauses, T, s, weighted_clauses=True)\n",
        "    for _ in range(best_epoch + 1):\n",
        "        tm_final.fit(X_trval, y_trval, epochs=1, incremental=True)\n",
        "\n",
        "    return tm_final, train_accs, val_accs, best_epoch\n",
        "\n",
        "\n",
        "def plot_curves(train_accs, val_accs, best_epoch, out_path):\n",
        "    epochs = np.arange(1, len(train_accs) + 1)\n",
        "    plt.figure(figsize=(7, 4))\n",
        "    plt.plot(epochs, train_accs, label=\"Train\")\n",
        "    plt.plot(epochs, val_accs, label=\"Validation\")\n",
        "    plt.axvline(best_epoch + 1, color=\"gray\", linestyle=\"--\",\n",
        "                label=f\"Epoca migliore ({best_epoch + 1})\")\n",
        "    plt.xlabel(\"Epoca\")\n",
        "    plt.ylabel(\"Accuracy\")\n",
        "    plt.title(\"Tsetlin Machine - curve di accuracy\")\n",
        "    plt.legend()\n",
        "    plt.grid(alpha=0.3)\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(out_path, dpi=150)\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# %% 5. Main\n",
        "def main(csv_path=CSV_PATH, n_bins=10, n_clauses=300, T=20, s=5.0,\n",
        "         max_epochs=60, val_size=0.2, seed=42, select_k=SELECT_K):\n",
        "    X_all, y_all, X_test_raw, y_test, names = load_features(csv_path)\n",
        "\n",
        "    X_train_raw, X_val_raw, y_train, y_val = train_test_split(\n",
        "        X_all, y_all, test_size=val_size, stratify=y_all, random_state=seed,\n",
        "    )\n",
        "\n",
        "    # Selezione feature (opzionale), fittata solo sul train\n",
        "    if select_k is not None:\n",
        "        from sklearn.feature_selection import SelectKBest, f_classif\n",
        "        sel = SelectKBest(f_classif, k=min(select_k, X_train_raw.shape[1]))\n",
        "        sel.fit(X_train_raw, y_train)\n",
        "        mask = sel.get_support()\n",
        "        X_all, X_train_raw = X_all[:, mask], X_train_raw[:, mask]\n",
        "        X_val_raw, X_test_raw = X_val_raw[:, mask], X_test_raw[:, mask]\n",
        "        names = [n for n, m in zip(names, mask) if m]\n",
        "        print(f\"Selezionate le {len(names)} feature migliori (ANOVA F, solo train)\")\n",
        "\n",
        "    # Soglie calcolate solo sul train (niente leakage su val/test)\n",
        "    edges = compute_bin_edges(X_train_raw, n_bins)\n",
        "    X_train = binarize_thermometer(X_train_raw, edges)\n",
        "    X_val = binarize_thermometer(X_val_raw, edges)\n",
        "    X_trval = binarize_thermometer(X_all, edges)\n",
        "    X_test = binarize_thermometer(X_test_raw, edges)\n",
        "\n",
        "    y_train = y_train.astype(np.uint32)\n",
        "    y_val = y_val.astype(np.uint32)\n",
        "    y_trval = y_all.astype(np.uint32)\n",
        "    y_test = y_test.astype(np.uint32)\n",
        "\n",
        "    print(f\"\\nInput binarizzato: {X_train.shape[1]} letterali \"\n",
        "          f\"({len(names)} feature, fino a {n_bins} soglie ciascuna)\")\n",
        "\n",
        "    print(\"\\n=== Fase 1: training con selezione dell'epoca migliore ===\")\n",
        "    tm_final, tr_accs, va_accs, best_epoch = train_tm_with_best_epoch(\n",
        "        X_train, y_train, X_val, y_val, X_trval, y_trval,\n",
        "        n_clauses=n_clauses, T=T, s=s, max_epochs=max_epochs, seed=seed,\n",
        "    )\n",
        "\n",
        "    plot_curves(tr_accs, va_accs, best_epoch, OUTPUT_DIR / \"tm_accuracy_curve.png\")\n",
        "\n",
        "    print(\"\\n=== Valutazione finale sul test set (pazienti 101-150) ===\")\n",
        "    test_pred = tm_final.predict(X_test)\n",
        "    print(f\"Test accuracy: {accuracy_score(y_test, test_pred):.3f}\\n\")\n",
        "    print(classification_report(y_test, test_pred, target_names=CLASSES, zero_division=0))\n",
        "    print(\"Matrice di confusione (righe=vero, colonne=predetto):\")\n",
        "    print(confusion_matrix(y_test, test_pred))\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
    }
  ]
