import pandas as pd


# ============================================================
# 1. File paths
# ============================================================

files = [
    ("Wolterink", "Wolterink_features.txt"),
    ("Khened", "Khened_features.csv"),
    ("Isensee", "Isensee_feature.csv"),
    ("Cetin", "Cetin_features.csv"),
]


# ============================================================
# 2. Load all feature files
# ============================================================

dataframes = []

for name, path in files:
    df = pd.read_csv(path)

    print(f"{name}: {df.shape[0]} rows, {df.shape[1]} columns")

    # Check that pid exists
    if "pid" not in df.columns:
        raise ValueError(f"'pid' column not found in {path}")

    # Check that each patient appears only once
    if df["pid"].duplicated().any():
        raise ValueError(f"Duplicated pid values found in {path}")

    dataframes.append((name, df))


# ============================================================
# 3. Start with the first feature table
# ============================================================

first_name, merged = dataframes[0]

# Keep track of columns that we already have
seen_columns = set(merged.columns)

# Store information about redundant columns
removed_columns = []


# ============================================================
# 4. Merge the remaining feature tables
# ============================================================

for name, df in dataframes[1:]:

    # Find columns that are already present.
    # pid is intentionally excluded because it is the merge key.
    duplicate_columns = [
        col for col in df.columns
        if col in seen_columns and col != "pid"
    ]

    if duplicate_columns:
        print(f"\nRedundant columns in {name}:")
        for col in duplicate_columns:
            print(f"  - {col}")
            removed_columns.append((name, col))

    # Keep:
    #   1. pid, for matching patients
    #   2. only columns that have not appeared before
    new_columns = [
        col for col in df.columns
        if col not in seen_columns
    ]

    columns_to_keep = ["pid"] + new_columns

    # Merge patients using pid
    merged = merged.merge(
        df[columns_to_keep],
        on="pid",
        how="outer",
        validate="one_to_one"
    )

    # Update the list of columns already encountered
    seen_columns.update(new_columns)


# ============================================================
# 5. Put identification / metadata columns first
# ============================================================

metadata_columns = [
    col for col in ["pid", "group", "height", "weight"]
    if col in merged.columns
]

feature_columns = [
    col for col in merged.columns
    if col not in metadata_columns
]

merged = merged[metadata_columns + feature_columns]


# ============================================================
# 6. Sort patients by pid
# ============================================================

merged = merged.sort_values("pid").reset_index(drop=True)


# ============================================================
# 7. Save the final dataset
# ============================================================

output_file = "all_features_no_redundancy.csv"

merged.to_csv(output_file, index=False)


# ============================================================
# 8. Summary
# ============================================================

print("\n==========================================")
print("MERGE COMPLETED")
print("==========================================")

print(f"Number of patients: {merged.shape[0]}")
print(f"Number of columns:  {merged.shape[1]}")
print(f"Redundant column occurrences removed: {len(removed_columns)}")

print("\nRemoved redundant columns:")

for source, column in removed_columns:
    print(f"  {source}: {column}")

print(f"\nOutput saved to: {output_file}")
