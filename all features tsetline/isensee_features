"""Isensee et al. 2017 diagnosis features (paper Table 1): instant features at ED and ES,
patient information and dynamic volume features over the whole cardiac cycle.

The paper lists the features but not their exact formulas; the definitions below are our
implementation (documented in README.md). Segmentations are resampled to 1.25x1.25x10 mm.
"""
import numpy as np
from scipy import ndimage, stats
from skimage.measure import perimeter

from isensee_lib import resample_seg
from common.data import bsa_mosteller

RV, MYO, LV = 1, 2, 3
PIX = 1.25  # in-plane mm after resampling


def slice_thickness(sl):
    """Myocardial thickness samples (mm) at endocardial border points of one 2D slice, and the
    subset belonging to the septum (sector facing the RV cavity)."""
    myo, lv, rv = sl == MYO, sl == LV, sl == RV
    if myo.sum() == 0 or lv.sum() == 0:
        return None, None
    epi = myo | lv
    dist_out = ndimage.distance_transform_edt(epi) * PIX  # distance to outside of the epicardium
    endo_border = myo & ndimage.binary_dilation(lv)
    if endo_border.sum() == 0:
        return None, None
    pts = np.argwhere(endo_border)
    th = dist_out[endo_border]
    sept = None
    if rv.sum() > 0:
        c_lv, c_rv = np.argwhere(lv).mean(0), np.argwhere(rv).mean(0)
        v = c_rv - c_lv
        u = pts - c_lv
        cosang = (u @ v) / (np.linalg.norm(u, axis=1) * np.linalg.norm(v) + 1e-8)
        sel = cosang > np.cos(np.deg2rad(45))
        sept = th[sel] if sel.sum() > 0 else None
    return th, sept


def shape_stats(mask2d):
    a = mask2d.sum() * PIX ** 2
    if a == 0:
        return None
    per = perimeter(mask2d) * PIX
    return a, per, 4 * np.pi * a / max(per, 1e-6) ** 2


def instant_features(seg, bsa, prefix):
    """seg: (Z, X, Y) on the 1.25x1.25x10 grid."""
    f = {}
    vox_ml = PIX * PIX * 10.0 / 1000.0
    th_max, th_min, th_std, th_mean, se_std, se_mean = [], [], [], [], [], []
    for sl in seg:
        th, sept = slice_thickness(sl)
        if th is None:
            continue
        th_max.append(th.max()); th_min.append(th.min()); th_std.append(th.std()); th_mean.append(th.mean())
        if sept is not None:
            se_std.append(sept.std()); se_mean.append(sept.mean())
    f['LVM_max_thickness'] = max(th_max) if th_max else 0
    f['LVM_min_thickness'] = min(th_min) if th_min else 0
    f['LVM_std_thickness'] = np.mean(th_std) if th_std else 0
    f['LVM_mean_thickness'] = np.mean(th_mean) if th_mean else 0
    f['LVM_septum_std_thickness'] = np.mean(se_std) if se_std else 0
    f['LVM_septum_mean_thickness'] = np.mean(se_mean) if se_mean else 0
    for name, lab in [('RVC', RV), ('LVC', LV)]:
        st = [shape_stats(sl == lab) for sl in seg]
        st = [s for s in st if s is not None]
        f[name + '_mean_circularity'] = np.mean([s[2] for s in st]) if st else 0
        f[name + '_max_circumference'] = max(s[1] for s in st) if st else 0
        f[name + '_mean_circumference'] = np.mean([s[1] for s in st]) if st else 0
    # most apical slice containing myocardium: the end of the myocardial extent with smaller LV area
    zs = [z for z in range(len(seg)) if (seg[z] == MYO).any()]
    if zs:
        lv_area = lambda z: (seg[z] == LV).sum()  # noqa: E731
        z_ap = zs[0] if lv_area(zs[0]) < lv_area(zs[-1]) else zs[-1]
        rv_a, lv_a = (seg[z_ap] == RV).sum() * PIX ** 2, (seg[z_ap] == LV).sum() * PIX ** 2
    else:
        rv_a, lv_a = 0, 0
    f['RVC_size_apical'] = rv_a
    f['RVC_LVC_ratio_apical'] = rv_a / (lv_a + 1.0)
    for name, lab in [('RVC', RV), ('LVM', MYO), ('LVC', LV)]:
        f[name + '_volume_per_bsa'] = (seg == lab).sum() * vox_ml / bsa
    f['LVM_mass'] = (seg == MYO).sum() * vox_ml * 1.05
    return {prefix + '_' + k: float(v) for k, v in f.items()}


def dynamic_features(vol_curves):
    """vol_curves: dict name -> array of volumes (ml) over all frames."""
    f = {}
    t_min_lvc = int(np.argmin(vol_curves['LVC']))
    for name in ['RVC', 'LVM', 'LVC']:
        v = np.asarray(vol_curves[name], float)
        vmax = v.max()
        vmin = v[t_min_lvc] if name == 'LVM' else v.min()
        f[name + '_vmax'] = vmax
        f[name + '_vmin'] = vmin
        f[name + '_dyn_EF'] = (vmax - vmin) / vmax if vmax > 0 else 0
        f[name + '_vol_median'] = np.median(v)
        f[name + '_vol_kurtosis'] = stats.kurtosis(v) if v.std() > 0 else 0
        f[name + '_vol_skewness'] = stats.skew(v) if v.std() > 0 else 0
        f[name + '_vol_std'] = v.std()
    f['ratio_vmin_LVC_RVC'] = f['LVC_vmin'] / max(f['RVC_vmin'], 1e-3)
    f['ratio_vmin_LVM_LVC'] = f['LVM_vmin'] / max(f['LVC_vmin'], 1e-3)
    f['ratio_vmin_RVC_LVM'] = f['RVC_vmin'] / max(f['LVM_vmin'], 1e-3)
    f['dt_vmin_LVC_RVC'] = float(np.argmin(vol_curves['LVC']) - np.argmin(vol_curves['RVC']))
    f['dt_vmax_LVC_RVC'] = float(np.argmax(vol_curves['LVC']) - np.argmax(vol_curves['RVC']))
    return {'dyn_' + k: float(v) for k, v in f.items()}


def patient_features(info, seg_ed, seg_es, spacing, seg_4d=None, spacing_4d=None):
    """seg_ed/seg_es: (Z,X,Y) on the original grid; seg_4d: (T,Z,X,Y) original grid (optional)."""
    h, w = info['height'], info['weight']
    bsa = bsa_mosteller(h, w)
    f = {'weight': w, 'height': h, 'BMI': w / (h / 100.0) ** 2}
    for ph, s in [('ED', seg_ed), ('ES', seg_es)]:
        f.update(instant_features(resample_seg(s, spacing, 3), bsa, ph))
    if seg_4d is not None:
        vox = np.prod(spacing_4d) / 1000.0
        curves = {n: (seg_4d == lab).reshape(len(seg_4d), -1).sum(1) * vox for n, lab in [('RVC', RV), ('LVM', MYO), ('LVC', LV)]}
        f.update(dynamic_features(curves))
    return f
