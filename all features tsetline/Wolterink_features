"""Wolterink et al. diagnosis: 14 features (weight, height, LV/RV/MYO volumes at ED and ES,
LV and RV EF, RV/LV and MYO/LV volume ratios at ED and ES) + random forest with 1000
full-depth trees; the class with highest posterior is assigned, posterior entropy = uncertainty.

Training features come from the out-of-fold CNN segmentations (stratified 4-fold CV, as in the
paper); test features from the 4-fold snapshot ensemble. `gt` rows use reference segmentations.
"""
import json
import os
import sys

import nibabel as nib
import numpy as np
import pandas as pd
from scipy.stats import entropy
from sklearn.ensemble import RandomForestClassifier

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, '..', '..'))
from common.data import load_patient, TRAIN_IDS, TEST_IDS  # noqa: E402
from common.metrics import classification_report, volume_ml  # noqa: E402
from train import get_split  # noqa: E402

FEATURES = ['weight', 'height', 'LV_ED', 'RV_ED', 'MYO_ED', 'LV_ES', 'RV_ES', 'MYO_ES', 'EF_LV', 'EF_RV',
            'RV_LV_ED', 'RV_LV_ES', 'MYO_LV_ED', 'MYO_LV_ES']


def seg_features(ed, es, sp):
    f = {}
    for ph, s in [('ED', ed), ('ES', es)]:
        for n, l in [('RV', 1), ('MYO', 2), ('LV', 3)]:
            f['%s_%s' % (n, ph)] = volume_ml(s, l, sp)
        f['RV_LV_' + ph] = f['RV_' + ph] / max(f['LV_' + ph], 1e-3)
        f['MYO_LV_' + ph] = f['MYO_' + ph] / max(f['LV_' + ph], 1e-3)
    f['EF_LV'] = (f['LV_ED'] - f['LV_ES']) / max(f['LV_ED'], 1e-3)
    f['EF_RV'] = (f['RV_ED'] - f['RV_ES']) / max(f['RV_ED'], 1e-3)
    return f


def load(d, pid, ph):
    return np.asarray(nib.load(os.path.join(d, 'patient%03d_%s.nii.gz' % (pid, ph))).dataobj).transpose(2, 0, 1)


def table(source):
    rows = []
    for pid in TRAIN_IDS + TEST_IDS:
        p = load_patient(pid)
        if source == 'gt':
            ed, es = p['gt_ED'], p['gt_ES']
        else:
            d = os.path.join(HERE, 'predictions', 'train_oof' if pid <= 100 else 'test')
            ed, es = load(d, pid, 'ED'), load(d, pid, 'ES')
        f = seg_features(ed, es, p['spacing'])
        f.update({'weight': p['weight'], 'height': p['height'], 'pid': pid, 'group': p['group']})
        rows.append(f)
    df = pd.DataFrame(rows)
    df.to_csv(os.path.join(HERE, 'results', 'features_%s.csv' % source), index=False)
    return df
